// HUNT 4: Password Spray vs Brute Force Distinction
// Hypothesis: Some attackers use password spray (1-2 passwords across many
//             accounts) to avoid lockout. The existing brute force rule misses this.
// MITRE: T1110.003 Password Spraying
// OUTCOME: This hunt identified a gap and was promoted to a new analytics rule.

SecurityEvent
| where EventID == 4625
| where TimeGenerated > ago(1h)
| summarize
    TargetedAccounts = dcount(TargetUserName),
    TotalAttempts = count(),
    AccountList = make_set(TargetUserName, 20)
    by IpAddress
| where TargetedAccounts >= 10
| extend
    AttemptsPerAccount = round(toreal(TotalAttempts) / toreal(TargetedAccounts), 1),
    AttackType = case(
        toreal(TotalAttempts) / toreal(TargetedAccounts) <= 3, "Password Spray",
        "Brute Force / Enumeration"
    )
| project IpAddress, TargetedAccounts, TotalAttempts, AttemptsPerAccount, AttackType, AccountList
| order by TargetedAccounts desc

// KEY INSIGHT:
// Brute force:    TotalAttempts/TargetedAccounts is HIGH (100+ per account)
// Password spray: TotalAttempts/TargetedAccounts is LOW  (1-3 per account)
//

